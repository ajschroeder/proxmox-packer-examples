/*
    DESCRIPTION:
    openSUSE Leap 16.1 variables used by the Packer Plugin for Proxmox (proxmox-iso).
*/

// Guest Operating System Metadata
vm_os_language = "en_US"
vm_os_keyboard = "us"
vm_os_timezone = "UTC"
vm_os_family   = "linux"
vm_os_name     = "opensuse-leap"
vm_os_version  = "16.1"

// Virtual Machine Guest Operating System Setting
vm_os_type   = "l26"
vm_cloudinit = true

// Virtual Machine Hardware Settings
vm_cpu_count            = 2
vm_cpu_sockets          = 1
vm_cpu_type             = "x86-64-v2-AES"
vm_mem_size             = 4096
vm_disk_type            = "virtio"
vm_disk_format          = "raw"
vm_disk_controller_type = "virtio-scsi-pci"
vm_network_card_model   = "virtio"

// Removable Media Settings
iso_path     = "iso"
iso_file     = "Leap-16.1-offline-installer-x86_64.install.iso"
iso_checksum = "file:https://download.opensuse.org/distribution/leap/16.1/offline/Leap-16.1-offline-installer-x86_64.install.iso.sha512"

// Boot Settings
vm_boot      = "order=virtio0;ide2;net0"
vm_boot_wait = "5s"
