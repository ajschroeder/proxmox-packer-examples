/*
    DESCRIPTION:
    Ansible credential variables used for Linux builds.
    - Variables are passed to and used by configuration scripts.
*/

// Ansible Credentials
// Note: ansible_key must include the key type prefix (e.g., "ssh-ed25519 AAAA... user@host" or "ssh-rsa AAAA... user@host")
ansible_username = "ansible"
ansible_key      = "<Full OpenSSH public key, e.g. ssh-ed25519 AAAA... user@host>"
