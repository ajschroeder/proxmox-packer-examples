/*
    DESCRIPTION:
    Firmware and storage variables used for Linux builds.
    - Configures VM firmware/EFI settings and the unified Storage API (`vm_storage`).
    - Pre-populated with the UEFI Baseline Single Disk LVM recipe (docs/storage/recipes/01-baseline-lvm.md).
    - To use a different storage layout, modify `vm_storage` below or replace the contents of this file
      with a recipe from docs/storage/recipes/.
    - Update `vm_efi_storage_pool` and each disk's `storage_pool` to match your Proxmox storage pool.
    - Partition and logical volume sizes are in MiB; use -1 to consume all remaining space.
*/

// VM Firmware & EFI Settings
vm_firmware              = "ovmf"
vm_efi_storage_pool      = "local-zfs"
vm_efi_type              = "4m"
vm_efi_pre_enrolled_keys = false

// VM Storage Configuration (UEFI Baseline Single Disk LVM)
vm_storage = {
  disks = [
    {
      size         = "32G"
      device       = "vda"
      storage_pool = "local-zfs"
      partitions = [
        {
          size = 512
          role = "efi"
          vg   = null
          filesystem = {
            fstype  = "fat32"
            label   = "EFI"
            mount   = "/boot/efi"
            options = ""
          }
        },
        {
          size = 1024
          role = "filesystem"
          vg   = null
          filesystem = {
            fstype  = "ext4"
            label   = "BOOT"
            mount   = "/boot"
            options = ""
          }
        },
        {
          size = -1
          role = "pv"
          vg   = "sysvg"
          filesystem = {
            fstype  = ""
            label   = ""
            mount   = ""
            options = ""
          }
        }
      ]
    }
  ]

  volume_groups = [
    {
      name = "sysvg"
      logical_volumes = [
        {
          name = "root"
          size = -1
          filesystem = {
            fstype  = "ext4"
            label   = "ROOT"
            mount   = "/"
            options = ""
          }
        },
        {
          name = "swap"
          size = 4096
          filesystem = {
            fstype  = "swap"
            label   = ""
            mount   = ""
            options = ""
          }
        }
      ]
    }
  ]
}
